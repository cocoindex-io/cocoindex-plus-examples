# Postgres database address for CocoIndex internal states
COCOINDEX_DB=postgres://cocoindex:cocoindex@localhost/cocoindex

# Postgres database address for the target table
POSTGRES_URL=postgres://cocoindex:cocoindex@localhost/cocoindex

# Fill in your GitHub app ID
GITHUB_APP_ID=
# Fill in the full path to the private key for your GitHub app
GITHUB_PRIVATE_KEY_PATH=

# GitHub repo holding the tenant config *.json files.
# Defaults point at this example's own example_configs/ on GitHub.
CONFIG_REPO_OWNER=cocoindex-io
CONFIG_REPO_NAME=cocoindex-plus-examples
# Optional: ref to read configs from (defaults to main)
CONFIG_GIT_REF=main
# Optional: directory in the config repo holding *.json
CONFIG_DIR=multi_github_code_indexing/example_configs
